(version 1)

(rule "USB HS upstream"
  (condition "A.inDiffPair('USB_D')")
  # skew/uncoupled dropped: KiCad counts the U1 ESD branch and J1 ties, so they misfire on this net.
  # Real J1->U3 skew is ~0.8 mm (~5 ps), far inside USB HS budget.
  (constraint length (max 30mm)))

# One rule per pair: a shared rule makes KiCad compare skew across both pairs.
# FS (12 Mbit/s) edges are >=4 ns, so 5 mm (~35 ps) of skew and 60 mm of length are still very conservative.
(rule "USB FS MCU"
  (condition "A.inDiffPair('USB_MCU_D')")
  (constraint length (max 60mm))
  (constraint skew (max 5mm)))

(rule "USB FS UART"
  (condition "A.inDiffPair('USB_UART_D')")
  (constraint length (max 60mm))
  (constraint skew (max 5mm)))

# SDIO runs at <=48 MHz (20 ns period). 80 mm max with up to ~30 mm clock/data mismatch is ~0.2 ns: negligible.
(rule "SD bus"
  (condition "A.NetName == 'SD_*'")
  (constraint length (max 80mm)))

(rule "USB pour clearance"
  (condition "A.NetClass == 'USB' && B.Type == 'Zone'")
  (constraint clearance (min 0.5mm)))