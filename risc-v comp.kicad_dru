(version 1)

(rule "USB HS upstream"
  (condition "A.inDiffPair('USB_D')")
  (constraint length (max 30mm))
  (constraint skew (max 0.15mm))
  (constraint diff_pair_uncoupled (max 3mm)))

(rule "USB FS ports"
  (condition "A.inDiffPair('USB_MCU_D') || A.inDiffPair('USB_UART_D')")
  (constraint length (max 50mm))
  (constraint skew (max 2mm)))

(rule "SD bus"
  (condition "A.NetName == 'SD_*'")
  (constraint length (max 40mm)))

(rule "USB pour clearance"
  (condition "A.NetClass == 'USB' && B.Type == 'Zone'")
  (constraint clearance (min 0.5mm)))